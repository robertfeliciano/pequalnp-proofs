theorem allRejected : (List.range 10).all (fun s => !(reachB s xsM)) = true := by
  decide +kernel

theorem noRunFull (s : Nat) (hs : s ≤ 9) (h : RunD dom_63 goalM s xsM) : False := by
  have hr := List.all_eq_true.mp allRejected s (List.mem_range.mpr (by omega))
  rw [reachB_complete h] at hr
  contradiction

