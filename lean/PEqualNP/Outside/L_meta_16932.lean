def dom_63 : Nat := 2 ^ 64 - 1
def roots_63 : List Nat := xs256.take 6
def goal_63 : Nat := 4277074666 * 2 ^ 32 + 4272617640
def goalM : Nat := goal_63 &&& dom_63
def xsM : List Nat := roots_63.map (· &&& dom_63)
def pairsG : List (Nat × Nat) := [(2, 3), (1, 3), (1, 5), (4, 12), (1, 17), (1, 33), (9, 3), (9, 5), (9, 12), (9, 17), (9, 26), (9, 33), (9, 38), (9, 50), (22, 3), (22, 5), (22, 12), (22, 17), (22, 26), (22, 33), (22, 38), (22, 50), (42, 3), (42, 5), (42, 12), (42, 17), (42, 26), (42, 33), (42, 38), (42, 50), (52, 3), (52, 5), (52, 12), (52, 17), (52, 26), (52, 33), (52, 38), (52, 50), (56, 3), (56, 5), (56, 12), (56, 17), (56, 26), (56, 33), (56, 38), (56, 50)]

def decorate (w : Nat) : Nat × Nat × Nat :=
  (w, projBit (pairsG.map Prod.fst) w, projBit (pairsG.map Prod.snd) w)

def searchD : Nat → List (Nat × Nat × Nat) → Bool
  | 0, ws => ws.map Prod.fst == [goalM]
  | n + 1, ws => decide (ws.length ≤ n + 2) &&
      nextD_cov dom_63 (maskP pairsG.length) n (n + 2 - ws.length) ws (searchD n)

def reachB (n : Nat) (ws : List Nat) : Bool := searchD n (ws.map decorate)

theorem reachB_complete {n : Nat} {ws : List Nat} (h : RunD dom_63 goalM n ws) :
    reachB n ws = true := by
  induction n generalizing ws with
  | zero => rw [zero_done h rfl]; simp [reachB, searchD, decorate]
  | succ n ih =>
    change (decide ((ws.map decorate).length ≤ n + 2) &&
      nextD_cov dom_63 (maskP pairsG.length) n
        (n + 2 - (ws.map decorate).length) (ws.map decorate) (searchD n)) = true
    simp only [List.length_map, Bool.and_eq_true, decide_eq_true_eq]
    refine ⟨by have hl := run_len h; omega, ?_⟩
    rw [nextD_cov_eq]
    rw [nextD_decor_eq (by decide +kernel) pairsG
      (by decide +kernel) (by decide +kernel)]
    apply nextD_complete h n rfl ws (List.Perm.refl _)
    intro ys hy
    have hc : coversP pairsG n ys = true :=
      coversP_ok (by decide +kernel) pairsG (by decide +kernel) hy
    rw [coversD_eq, hc, Bool.true_and]
    exact ih hy

